{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned dice ruleset conformance fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["ruleset", "version", "cases"],
  "properties": {
    "ruleset": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "scores": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dice", "category", "priorState", "selectable", "valid", "score", "bonusDelta", "expectedTotals"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dice": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "integer", "minimum": 1, "maximum": 6}},
        "category": {"type": "string", "minLength": 1},
        "priorState": {
          "type": "object", "additionalProperties": false,
          "required": ["scores", "repeatedFiveOfAKindBonusTotal"],
          "properties": {
            "scores": {"$ref": "#/$defs/scores"},
            "repeatedFiveOfAKindBonusTotal": {"type": "integer", "minimum": 0}
          }
        },
        "selectable": {"type": "boolean"},
        "valid": {"type": "boolean"},
        "score": {"type": "integer", "minimum": 0},
        "bonusDelta": {"type": "integer", "minimum": 0},
        "expectedTotals": {
          "type": "object", "additionalProperties": false,
          "required": ["upperSubtotal", "upperBonus", "lowerSubtotal", "repeatedFiveOfAKindBonusTotal", "finalTotal"],
          "properties": {
            "upperSubtotal": {"type": "integer", "minimum": 0},
            "upperBonus": {"type": "integer", "minimum": 0},
            "lowerSubtotal": {"type": "integer", "minimum": 0},
            "repeatedFiveOfAKindBonusTotal": {"type": "integer", "minimum": 0},
            "finalTotal": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
